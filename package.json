            "default": "./dist/ui/*.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "gen:fixtures": "pnpm exec tsx scripts/gen-fixtures-content.ts",
        "build": "pnpm run gen:fixtures && rm -rf dist *.tsbuildinfo && pnpm exec tsc -p tsconfig.build.json",
        "typecheck": "pnpm exec tsc --noEmit",
        "lint": "pnpm run prettify:check && pnpm exec eslint .",
        "prettify": "pnpm exec prettier --cache -w .",
        "prettify:check": "pnpm exec prettier --cache --check .",
        "test": "pnpm exec vitest run",
        "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
        "prepublishOnly": "pnpm run check"
    },
    "peerDependencies": {
        "@proposit/proposit-core": "^2.5.0"
    },
    "dependencies": {
        "typebox": "^1.1.14",
        "yaml": "^2.8.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@proposit/proposit-core": "^2.5.0",
        "@types/node": "^25.5.2",
        "eslint": "^9.39.4",
        "eslint-plugin-check-file": "^3.3.1",
        "globals": "^17.4.0",
        "jsdom": "^29.0.2",
        "prettier": "^3.8.1",
        "tsx": "^4.22.4",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.0",
        "uuid": "^13.0.0",
        "vitest": "^4.1.2"
    },
    "packageManager": "pnpm@10.23.0"
}
